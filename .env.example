# Gemini API Key (used only for teacher data distillation scripts in pre_process/)
GEMINI_API_KEY=your_gemini_api_key_here

# Local Ollama URL (default: http://localhost:11434)
OLLAMA_URL=http://localhost:11434

# Extractor and Compliance Reasoning Models
EXTRACTOR_MODEL=gdpr-slm-qwen3.5
COMPLIANCE_MODEL=qwen2.5:7b
